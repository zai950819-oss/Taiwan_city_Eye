# Get free keys at https://tdx.transportdata.tw (會員中心 → API 金鑰)
TDX_CLIENT_ID=
TDX_CLIENT_SECRET=

# 1 = synthetic data (no keys needed). Auto-enabled when keys are missing.
GODEYE_MOCK=0

# Which TDX camera sets to load (comma separated): Freeway, Highway, City/Taipei, City/NewTaipei, City/Taichung ...
GODEYE_CCTV_SOURCES=Freeway,Highway,City/Taipei

# Vision sampling — only cameras inside the area on screen (needs ultralytics)
GODEYE_VISION=1
GODEYE_VISION_MAX_CAMERAS=40
GODEYE_VISION_INTERVAL_S=120
GODEYE_VISION_CONCURRENCY=6

# Road-condition tags (wet/flood/fog/smoke) with CLIP, per camera at most every N seconds
GODEYE_CONDITIONS=1
GODEYE_CONDITION_INTERVAL_S=600

# Optional: 中央氣象署 rain gauges (free key: https://opendata.cwa.gov.tw → 會員 → API授權碼)
CWA_API_KEY=

GODEYE_DB=data/godeye.db
GODEYE_RETENTION_HOURS=72
